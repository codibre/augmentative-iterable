{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictNullChecks": true,
    "moduleResolution": "node",
    "lib": ["es6", "dom"],
    "sourceMap": false,
    "allowJs": true,
    "rootDir": ".",
    "declaration": true
  },
  "include": ["lib", "index.js", "index.d.ts"],
  "exclude": [".eslintrc.js"]
}
